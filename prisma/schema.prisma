// ─────────────────────────────────────────────────────────────
// Shopee Open Platform integration (isolated module)
//   - StockCard stays the source of truth; Shopee never writes Product.stock directly.
//   - Shopee numeric ids stored as String (serialization-safe in App Router).
//   - `shopRecordId` = internal FK to ShopeeShop.id (distinct from ShopeeShop.shopId
//     which is Shopee's real shop_id).
// ─────────────────────────────────────────────────────────────

model ShopeeShop {
  id                          String                 @id @default(cuid())
  shopId                      String                 @unique // Shopee shop_id (real marketplace id)
  shopName                    String?
  region                      String?
  authStatus                  ShopeeAuthStatus       @default(PENDING)
  accessToken                 String? // server-side only — never returned to client
  refreshToken                String?
  tokenExpiresAt              DateTime?              @db.Timestamptz(3)
  scope                       String?
  syncEnabled                 Boolean                @default(false)
  stockBuffer                 Int                    @default(0)
  lastOrderSyncAt             DateTime?              @db.Timestamptz(3)
  lastOrderCursor             String?
  lastStockSyncAt             DateTime?              @db.Timestamptz(3)
  lastError                   String?
  authorizedAt                DateTime?              @db.Timestamptz(3)
  authorizedByUserId          String?
  settlementCashBankAccountId String?
  createdAt                   DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime               @updatedAt @db.Timestamptz(3)
  authorizedByUser            User?                  @relation(fields: [authorizedByUserId], references: [id])
  settlementCashBankAccount   CashBankAccount?       @relation(fields: [settlementCashBankAccountId], references: [id])
  mappings                    ShopeeProductMapping[]
  orders                      ShopeeOrderImport[]
  syncJobs                    ShopeeSyncJob[]

  @@index([authStatus])
  @@index([tokenExpiresAt])
  @@index([authorizedByUserId])
  @@index([settlementCashBankAccountId])
}

model ShopeeProductMapping {
  id              String         @id @default(cuid())
  shopRecordId    String
  productId       String
  productUnitId   String?
  itemId          String // Shopee item_id
  modelId         String         @default("0") // Shopee model_id; "0" = no-variation
  sellerSku       String?
  syncMode        ShopeeSyncMode @default(MONITOR_ONLY)
  stockBuffer     Int? // overrides ShopeeShop.stockBuffer when set
  lastPushedStock Int?
  lastPushedAt    DateTime?      @db.Timestamptz(3)
  lastError       String?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  shop            ShopeeShop     @relation(fields: [shopRecordId], references: [id], onDelete: Cascade)
  product         Product        @relation(fields: [productId], references: [id])
  productUnit     ProductUnit?   @relation(fields: [productUnitId], references: [id])

  @@unique([shopRecordId, itemId, modelId])
  @@index([productId])
  @@index([itemId, modelId])
  @@index([shopRecordId, syncMode])
}

model ShopeeOrderImport {
  id                    String                  @id @default(cuid())
  shopRecordId          String
  orderSn               String // Shopee order_sn
  shopeeStatus          String
  importStatus          ShopeeOrderImportStatus @default(PENDING)
  buyerUsername         String?
  totalAmount           Decimal?                @db.Decimal(10, 2)
  currency              String?
  orderCreatedAt        DateTime?               @db.Timestamptz(3)
  orderUpdatedAt        DateTime?               @db.Timestamptz(3)
  rawPayload            Json?
  saleId                String?                 @unique
  escrowExpenseId       String?                 @unique
  escrowSyncedAt        DateTime?               @db.Timestamptz(3)
  escrowLastError       String?
  returnReviewRequired  Boolean                 @default(false)
  returnReviewReason    String?
  returnReviewFlaggedAt DateTime?               @db.Timestamptz(3)
  lastError             String?
  importedAt            DateTime?               @db.Timestamptz(3)
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(3)
  shop                  ShopeeShop              @relation(fields: [shopRecordId], references: [id], onDelete: Cascade)
  sale                  Sale?                   @relation(fields: [saleId], references: [id])
  escrowExpense         Expense?                @relation("ShopeeEscrowExpense", fields: [escrowExpenseId], references: [id])

  @@unique([shopRecordId, orderSn])
  @@index([importStatus, createdAt])
  @@index([shopRecordId, importStatus])
  @@index([returnReviewRequired, updatedAt])
  @@index([shopeeStatus])
}

model ShopeeSyncJob {
  id             String              @id @default(cuid())
  shopRecordId   String?
  type           ShopeeSyncJobType
  status         ShopeeSyncJobStatus @default(PENDING)
  idempotencyKey String?             @unique
  startedAt      DateTime?           @db.Timestamptz(3)
  finishedAt     DateTime?           @db.Timestamptz(3)
  itemsProcessed Int                 @default(0)
  itemsFailed    Int                 @default(0)
  attemptCount   Int                 @default(0)
  maxAttempts    Int                 @default(3)
  lastError      String?
  metaJson       Json?
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)
  shop           ShopeeShop?         @relation(fields: [shopRecordId], references: [id], onDelete: Cascade)

  @@index([type, status, createdAt])
  @@index([shopRecordId, type, status])
}

// In-app notification bell (general-purpose; per-user fan-out rows).
model Notification {
  id         String               @id @default(cuid())
  type       NotificationType
  severity   NotificationSeverity @default(INFO)
  title      String
  body       String?
  userId     String
  link       String?
  entityType String?
  entityId   String?
  readAt     DateTime?            @db.Timestamptz(3)
  dedupeKey  String?
  createdAt  DateTime             @default(now()) @db.Timestamptz(3)
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([type, createdAt])
  @@index([dedupeKey])
}

