  receipt    Receipt     @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  sale       Sale?       @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@index([receiptId])
  @@index([cnId])
}

model SupplierAdvance {
  id                String                @id @default(cuid())
  advanceNo         String                @unique
  advanceDate       DateTime              @default(now()) @db.Timestamptz(3)
  supplierId        String
  userId            String
  totalAmount       Decimal               @db.Decimal(10, 2)
  amountRemain      Decimal               @default(0) @db.Decimal(10, 2)
  paymentMethod     PaymentMethod         @default(TRANSFER)
  note              String?
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)
  cancelNote        String?
  cancelledAt       DateTime?             @db.Timestamptz(3)
  status            DocStatus             @default(ACTIVE)
  cashBankAccountId String?
  cashBankAccount   CashBankAccount?      @relation(fields: [cashBankAccountId], references: [id])
  supplier          Supplier              @relation(fields: [supplierId], references: [id])
  user              User                  @relation(fields: [userId], references: [id])
  supplierPayments  SupplierPaymentItem[]

  @@index([advanceDate])
  @@index([supplierId, status])
  @@index([cashBankAccountId])
  @@index([userId])
}

model SupplierPayment {
  id                String                @id @default(cuid())
  paymentNo         String                @unique
  paymentDate       DateTime              @default(now()) @db.Timestamptz(3)
  supplierId        String
  userId            String
  totalAmount       Decimal               @db.Decimal(10, 2)
  paymentMethod     PaymentMethod         @default(CREDIT)
  note              String?
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)
  cancelNote        String?
  cancelledAt       DateTime?             @db.Timestamptz(3)
  status            DocStatus             @default(ACTIVE)
  cashBankAccountId String?
  cashBankAccount   CashBankAccount?      @relation(fields: [cashBankAccountId], references: [id])
  supplier          Supplier              @relation(fields: [supplierId], references: [id])
  user              User                  @relation(fields: [userId], references: [id])
  items             SupplierPaymentItem[]

  @@index([paymentDate])
  @@index([supplierId, status])
  @@index([cashBankAccountId])
  @@index([userId])
}

model SupplierPaymentItem {
  id               String           @id @default(cuid())
  paymentId        String
  purchaseId       String?
  purchaseReturnId String?
  advanceId        String?
  paidAmount       Decimal          @db.Decimal(10, 2)
  advance          SupplierAdvance? @relation(fields: [advanceId], references: [id])
  payment          SupplierPayment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  purchase         Purchase?        @relation(fields: [purchaseId], references: [id])
  purchaseReturn   PurchaseReturn?  @relation(fields: [purchaseReturnId], references: [id])

  @@index([paymentId])
  @@index([purchaseId])
  @@index([purchaseReturnId])
  @@index([advanceId])
}

model ProductLot {
  id             String    @id @default(cuid())
  productId      String
  lotNo          String
  purchaseItemId String?
  mfgDate        DateTime? @db.Timestamptz(3)
  expDate        DateTime? @db.Timestamptz(3)
  unitCost       Decimal   @db.Decimal(10, 4)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  product        Product   @relation(fields: [productId], references: [id])

  @@unique([productId, lotNo])
  @@index([productId, expDate])
}

model LotBalance {
  id        String  @id @default(cuid())
  productId String
  lotNo     String
  qtyOnHand Decimal @default(0) @db.Decimal(12, 4)
  product   Product @relation(fields: [productId], references: [id])

  @@unique([productId, lotNo])
  @@index([productId])
}

model StockMovementLot {
  id          String    @id @default(cuid())
  stockCardId String
  lotNo       String
  qtyIn       Decimal   @default(0) @db.Decimal(12, 4)
  qtyOut      Decimal   @default(0) @db.Decimal(12, 4)
  unitCost    Decimal   @default(0) @db.Decimal(10, 4)
  stockCard   StockCard @relation(fields: [stockCardId], references: [id], onDelete: Cascade)

  @@index([stockCardId])
  @@index([lotNo])
}

model PurchaseItemLot {
  id             String       @id @default(cuid())
  purchaseItemId String
  lotNo          String
  qty            Decimal      @db.Decimal(12, 4)
  unitCost       Decimal      @db.Decimal(10, 4)
  mfgDate        DateTime?    @db.Timestamptz(3)
  expDate        DateTime?    @db.Timestamptz(3)
  purchaseItem   PurchaseItem @relation(fields: [purchaseItemId], references: [id], onDelete: Cascade)

  @@index([purchaseItemId])
}

model SaleItemLot {
  id         String   @id @default(cuid())
  saleItemId String
  lotNo      String
  qty        Decimal  @db.Decimal(12, 4)
  unitCost   Decimal  @db.Decimal(10, 4)
  saleItem   SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)

  @@index([saleItemId])
}

model PurchaseReturnItemLot {
  id                   String             @id @default(cuid())
  purchaseReturnItemId String
  lotNo                String
  qty                  Decimal            @db.Decimal(12, 4)
  purchaseReturnItem   PurchaseReturnItem @relation(fields: [purchaseReturnItemId], references: [id], onDelete: Cascade)

  @@index([purchaseReturnItemId])
}

model CreditNoteItemLot {
  id               String         @id @default(cuid())
  creditNoteItemId String
  lotNo            String
  qty              Decimal        @db.Decimal(12, 4)
  isReturnLot      Boolean        @default(false)
  creditNoteItem   CreditNoteItem @relation(fields: [creditNoteItemId], references: [id], onDelete: Cascade)

  @@index([creditNoteItemId])
}

