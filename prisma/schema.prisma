generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                            String                     @id @default(cuid())
  name                          String
  email                         String                     @unique
  password                      String
  role                          Role                       @default(STAFF)
  isActive                      Boolean                    @default(true)
  createdAt                     DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt                     DateTime                   @updatedAt @db.Timestamptz(3)
  appRoleId                     String?
  mustChangePassword            Boolean                    @default(false)
  username                      String?                    @unique
  signatureUpdatedAt            DateTime?                  @db.Timestamptz(3)
  signatureUrl                  String?
  phone                         String?
  adjustments                   Adjustment[]
  auditLogs                     AuditLog[]
  balanceForwards               BalanceForward[]
  cashBankAdjustments           CashBankAdjustment[]
  cashBankTransfers             CashBankTransfer[]
  contentApprovalsToReview      ContentApproval[]          @relation("ContentApprovalApprover")
  contentApprovalsRequested     ContentApproval[]          @relation("ContentApprovalRequestedBy")
  contentAuditLogs              ContentAuditLog[]          @relation("ContentAuditActor")
  contentPostsApproved          ContentPost[]              @relation("ContentPostApprovedBy")
  contentPostsCreated           ContentPost[]              @relation("ContentPostCreatedBy")
  contentScheduledJobsCreated   ContentScheduledJob[]      @relation("ContentScheduledJobCreatedBy")
  creditNotes                   CreditNote[]
  deliveryCommissionRuns        DeliveryCommissionRun[]    @relation("DeliveryCommissionStaff")
  deliveryCommissionRunsCreated DeliveryCommissionRun[]    @relation("DeliveryCommissionCreatedBy")
  deliveryProofs                DeliveryProof[]
  expenses                      Expense[]
  lineSummaryDispatches         LineDailySummaryDispatch[]
  purchases                     Purchase[]
  purchaseReturns               PurchaseReturn[]
  receipts                      Receipt[]
  deliverySales                 Sale[]                     @relation("SaleDeliveryStaff")
  sales                         Sale[]
  supplierAdvances              SupplierAdvance[]
  supplierPayments              SupplierPayment[]
  appRole                       AppRole?                   @relation(fields: [appRoleId], references: [id])
  lineRecipientLinks            UserLineRecipient?

  @@index([username])
  @@index([appRoleId])
}

model LineRecipient {
  id            String              @id @default(cuid())
  lineId        String              @unique
  type          LineRecipientType
  status        LineRecipientStatus @default(ACTIVE)
  displayName   String?
  sourceName    String?
  sourceDetail  String?
  lastWebhookAt DateTime?           @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(3)
  userLinks     UserLineRecipient?

  @@index([type, status])
}

model UserLineRecipient {
  id          String        @id @default(cuid())
  userId      String        @unique
  recipientId String        @unique
  note        String?
  linkedAt    DateTime      @default(now()) @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
  recipient   LineRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([recipientId])
}

model LineDailySummaryDispatch {
  id                String                         @id @default(cuid())
  dispatchKey       String?                        @unique
  reportDayKey      String
  dispatchKind      LineDailySummaryDispatchKind
  status            LineDailySummaryDispatchStatus
  targetMode        LineDailySummaryTargetMode
  recipientCount    Int                            @default(0)
  sentCount         Int                            @default(0)
  recipientSnapshot String?
  errorMessage      String?
  sentAt            DateTime?                      @db.Timestamptz(3)
  createdAt         DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                       @updatedAt @db.Timestamptz(3)
  triggeredByUserId String?
  triggeredByUser   User?                          @relation(fields: [triggeredByUserId], references: [id])

  @@index([reportDayKey, dispatchKind])
  @@index([status, createdAt])
  @@index([triggeredByUserId])
}

model ContentPost {
  id                String                @id @default(cuid())
  channel           ContentChannel
  title             String?
  caption           String
  imageUrl          String?
  linkUrl           String?
  status            ContentPostStatus     @default(DRAFT)
  scheduledAt       DateTime?             @db.Timestamptz(3)
  approvedAt        DateTime?             @db.Timestamptz(3)
  postedAt          DateTime?             @db.Timestamptz(3)
  cancelledAt       DateTime?             @db.Timestamptz(3)
  failedAt          DateTime?             @db.Timestamptz(3)
  facebookPageId    String
  metaPostId        String?
  lastError         String?
  draftSource       String?
  timezone          String                @default("Asia/Bangkok")
  variantGroupId    String?
  variantNo         Int?
  isSelectedVariant Boolean               @default(false)
  createdByUserId   String
  approvedByUserId  String?
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)
  approvals         ContentApproval[]
  auditLogs         ContentAuditLog[]
  approvedByUser    User?                 @relation("ContentPostApprovedBy", fields: [approvedByUserId], references: [id])
  createdByUser     User                  @relation("ContentPostCreatedBy", fields: [createdByUserId], references: [id])
  scheduledJobs     ContentScheduledJob[]

  @@index([channel, status, scheduledAt])
  @@index([createdByUserId, createdAt])
  @@index([approvedByUserId])
  @@index([facebookPageId, status])
  @@index([postedAt])
  @@index([variantGroupId, variantNo])
}

model ContentApproval {
  id                String                @id @default(cuid())
  postId            String
  requestedByUserId String
  approverUserId    String
  status            ContentApprovalStatus @default(PENDING)
  requestNote       String?
  decisionNote      String?
  requestedAt       DateTime              @default(now()) @db.Timestamptz(3)
  actedAt           DateTime?             @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)
  approverUser      User                  @relation("ContentApprovalApprover", fields: [approverUserId], references: [id])
  post              ContentPost           @relation(fields: [postId], references: [id], onDelete: Cascade)
  requestedByUser   User                  @relation("ContentApprovalRequestedBy", fields: [requestedByUserId], references: [id])

  @@index([postId, status])
  @@index([approverUserId, status, requestedAt])
  @@index([requestedByUserId])
}

model ContentScheduledJob {
  id                String                    @id @default(cuid())
  postId            String
  type              ContentScheduledJobType
  status            ContentScheduledJobStatus @default(PENDING)
  provider          String
  providerMessageId String?
  idempotencyKey    String                    @unique
  runAt             DateTime                  @db.Timestamptz(3)
  startedAt         DateTime?                 @db.Timestamptz(3)
  finishedAt        DateTime?                 @db.Timestamptz(3)
  attemptCount      Int                       @default(0)
  maxAttempts       Int                       @default(3)
  lastError         String?
  payloadJson       String?
  createdByUserId   String?
  createdAt         DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                  @updatedAt @db.Timestamptz(3)
  createdByUser     User?                     @relation("ContentScheduledJobCreatedBy", fields: [createdByUserId], references: [id])
  post              ContentPost               @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([postId, type, status])
  @@index([provider, providerMessageId])
  @@index([createdByUserId])
}

model ContentAuditLog {
  id               String                   @id @default(cuid())
  postId           String
  actorUserId      String?
  action           String
  detail           String?
  metadataJson     String?
  notificationType ContentNotificationType?
  createdAt        DateTime                 @default(now()) @db.Timestamptz(3)
  actorUser        User?                    @relation("ContentAuditActor", fields: [actorUserId], references: [id])
  post             ContentPost              @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  userName   String?
  userRole   String?
  action     AuditAction
  entityType String
  entityId   String?
  entityRef  String?
  before     Json?
  after      Json?
  meta       Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  user       User?       @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

model LoginThrottle {
  key            String    @id
  failures       Int       @default(0)
  firstFailureAt DateTime? @db.Timestamptz(3)
  lockedUntil    DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
}

model AppRole {
  id          String              @id @default(cuid())
  name        String              @unique
  description String?
  isSystem    Boolean             @default(false)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  permissions AppRolePermission[]
  users       User[]
}

model Permission {
  id          String              @id @default(cuid())
  key         String              @unique
  group       String
  label       String
  description String?
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  roles       AppRolePermission[]
}

model AppRolePermission {
  appRoleId    String
  permissionId String
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  appRole      AppRole    @relation(fields: [appRoleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([appRoleId, permissionId])
  @@index([permissionId])
}

model CarBrand {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  isActive  Boolean    @default(true)
  carModels CarModel[]
}

model CarModel {
  id         String           @id @default(cuid())
  name       String
  carBrandId String
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  isActive   Boolean          @default(true)
  carBrand   CarBrand         @relation(fields: [carBrandId], references: [id])
  products   ProductFitment[]

  @@unique([name, carBrandId])
  @@index([carBrandId])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  isActive  Boolean   @default(true)
  slug      String?   @unique
  products  Product[]
}

model Supplier {
  id                String            @id @default(cuid())
  name              String            @unique
  contactName       String?
  phone             String?
  address           String?
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  code              String?           @unique
  isActive          Boolean           @default(true)
  taxId             String?
  creditTerm        Int?
  preferredProducts Product[]         @relation("ProductPreferredSupplier")
  purchases         Purchase[]
  purchaseItems     PurchaseItem[]
  purchaseReturns   PurchaseReturn[]
  supplierAdvances  SupplierAdvance[]
  supplierPayments  SupplierPayment[]
  warrantyClaims    WarrantyClaim[]
}

model PartsBrand {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  isActive  Boolean   @default(true)
  products  Product[]
}

model Product {
  id                  String               @id @default(cuid())
  code                String               @unique
  name                String
  description         String?
  categoryId          String
  shelfLocation       String?
  costPrice           Decimal              @default(0) @db.Decimal(10, 2)
  salePrice           Decimal              @default(0) @db.Decimal(10, 2)
  stock               Int                  @default(0)
  minStock            Int                  @default(1)
  imageUrl            String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  purchaseUnitName    String               @default("ชิ้น")
  reportUnitName      String               @default("ชิ้น")
  saleUnitName        String               @default("ชิ้น")
  brandId             String?
  avgCost             Decimal              @default(0) @db.Decimal(10, 2)
  warrantyDays        Int                  @default(0)
  preferredSupplierId String?
  allowExpiredIssue   Boolean              @default(false)
  isLotControl        Boolean              @default(false)
  lotIssueMethod      LotIssueMethod       @default(FIFO)
  requireExpiryDate   Boolean              @default(false)
  slug                String?              @unique
  inventoryTracking   InventoryTracking    @default(TRACKED)
  adjustmentItems     AdjustmentItem[]
  balanceForwards     BalanceForward[]
  claimStockBalances  ClaimStockBalance[]
  claimStockMovements ClaimStockMovement[]
  creditNoteItems     CreditNoteItem[]
  lotBalances         LotBalance[]
  brand               PartsBrand?          @relation(fields: [brandId], references: [id])
  category            Category             @relation(fields: [categoryId], references: [id])
  preferredSupplier   Supplier?            @relation("ProductPreferredSupplier", fields: [preferredSupplierId], references: [id])
  aliases             ProductAlias[]
  carModels           ProductFitment[]
  images              ProductImage[]
  lots                ProductLot[]
  units               ProductUnit[]
  purchaseItems       PurchaseItem[]
  purchaseReturnItems PurchaseReturnItem[]
  saleItems           SaleItem[]
  stockCards          StockCard[]
  warranties          Warranty[]

  @@index([categoryId])
  @@index([brandId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([productId, isPrimary])
}

model ProductUnit {
  id        String   @id @default(cuid())
  productId String
  name      String
  scale     Float
  isBase    Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
}

model ProductAlias {
  id        String    @id @default(cuid())
  productId String
  alias     String
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  kind      AliasKind @default(ALIAS)
  weight    Int?
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, alias, kind])
  @@index([alias])
  @@index([kind])
}

/// Global search synonym dictionary (Phase D).
/// Bi-directional: a query matching `term` OR any item in `synonyms[]` will expand to cover all related terms.
model SearchSynonym {
  id        String   @id @default(cuid())
  term      String   @unique
  synonyms  String[] @default([])
  language  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([isActive])
}

model ProductSearchLog {
  id          String   @id @default(cuid())
  query       String   @db.VarChar(200)
  filters     Json?
  resultCount Int      @default(0)
  source      String   @db.VarChar(30)
  path        String?  @db.VarChar(200)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  dedupeKey   String?  @unique @db.VarChar(280)
  hitCount    Int      @default(1)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([createdAt(sort: Desc)])
  @@index([source, createdAt(sort: Desc)])
  @@index([resultCount, createdAt(sort: Desc)])
}

model ProductSearchReviewOutcome {
  id               String                    @id @default(cuid())
  normalizedQuery  String                    @db.VarChar(200)
  candidateAction  String                    @db.VarChar(50)
  status           ProductSearchReviewStatus @default(PENDING)
  note             String?                   @db.VarChar(500)
  appliedType      String?                   @db.VarChar(50)
  appliedRef       String?                   @db.VarChar(100)
  reviewedById     String?
  reviewedByName   String?                   @db.VarChar(100)
  reviewedAt       DateTime?                 @db.Timestamptz(3)
  createdAt        DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                  @updatedAt @db.Timestamptz(3)
  baselineCount    Int?
  baselineAvg      Float?
  baselineLatestAt DateTime?                 @db.Timestamptz(3)
  baselineSources  Json?

  @@unique([normalizedQuery, candidateAction])
  @@index([status, updatedAt(sort: Desc)])
  @@index([reviewedAt(sort: Desc)])
}

model ProductSearchClusterCache {
  id               String   @id @default(cuid())
  windowKey        String   @db.VarChar(20)
  normalizedQuery  String   @db.VarChar(200)
  candidateAction  String   @db.VarChar(50)
  bucket           String   @db.VarChar(20)
  count            Int
  minResultCount   Int
  avgResultCount   Decimal  @db.Decimal(10, 2)
  latestAt         DateTime @db.Timestamptz(3)
  rawQueriesSample Json
  sourceCounts     Json
  windowStart      DateTime @db.Timestamptz(3)
  windowEnd        DateTime @db.Timestamptz(3)
  computedAt       DateTime @default(now()) @db.Timestamptz(3)

  @@unique([windowKey, normalizedQuery, candidateAction])
  @@index([windowKey, computedAt])
}

model ProductFitment {
  productId  String
  carModelId String
  id         String   @id @default(cuid())
  submodel   String?
  yearStart  Int?
  yearEnd    Int?
  engineCode String?
  engineSize String?
  note       String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  carModel   CarModel @relation(fields: [carModelId], references: [id])
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, carModelId, submodel, yearStart, yearEnd, engineCode])
  @@index([carModelId, productId])
  @@index([carModelId, yearStart, yearEnd])
  @@map("ProductCarModel")
}

model StockCard {
  id                  String               @id @default(cuid())
  productId           String
  docNo               String
  docDate             DateTime             @db.Timestamptz(3)
  source              StockCardSource
  sorder              Int
  qtyIn               Decimal              @default(0) @db.Decimal(12, 4)
  qtyOut              Decimal              @default(0) @db.Decimal(12, 4)
  qtyBalance          Decimal              @default(0) @db.Decimal(12, 4)
  priceIn             Decimal              @default(0) @db.Decimal(10, 4)
  priceOut            Decimal              @default(0) @db.Decimal(10, 4)
  priceBalance        Decimal              @default(0) @db.Decimal(10, 4)
  detail              String?
  referenceId         String?
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  landedCost          Decimal              @default(0) @db.Decimal(10, 2)
  usesReferenceCost   Boolean              @default(false)
  claimStockMovements ClaimStockMovement[]
  product             Product              @relation(fields: [productId], references: [id])
  lotMovements        StockMovementLot[]

  @@index([productId, docDate, sorder])
  @@index([docNo])
}

model BalanceForward {
  id              String    @id @default(cuid())
  docNo           String    @unique
  docDate         DateTime  @db.Timestamptz(3)
  productId       String
  unitName        String
  qtyInBase       Decimal   @db.Decimal(12, 4)
  costPerBaseUnit Decimal   @db.Decimal(10, 4)
  note            String?
  status          DocStatus @default(ACTIVE)
  cancelledAt     DateTime? @db.Timestamptz(3)
  cancelNote      String?
  userId          String
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  product         Product   @relation(fields: [productId], references: [id])
  user            User      @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([docDate])
}

model Purchase {
  id                   String                @id @default(cuid())
  purchaseNo           String                @unique
  supplierId           String?
  userId               String
  totalAmount          Decimal               @db.Decimal(10, 2)
  discount             Decimal               @default(0) @db.Decimal(10, 2)
  netAmount            Decimal               @db.Decimal(10, 2)
  note                 String?
  purchaseDate         DateTime              @default(now()) @db.Timestamptz(3)
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  referenceNo          String?
  subtotalAmount       Decimal               @default(0) @db.Decimal(10, 2)
  vatAmount            Decimal               @default(0) @db.Decimal(10, 2)
  vatRate              Decimal               @default(0) @db.Decimal(5, 2)
  vatType              VatType               @default(NO_VAT)
  cancelNote           String?
  cancelledAt          DateTime?             @db.Timestamptz(3)
  status               DocStatus             @default(ACTIVE)
  amountRemain         Decimal               @default(0) @db.Decimal(10, 2)
  paymentMethod        PaymentMethod         @default(TRANSFER)
  cashBankAccountId    String?
  paymentStatus        PurchasePaymentStatus @default(UNPAID)
  purchaseType         PurchaseType          @default(CREDIT_PURCHASE)
  creditTerm           Int?
  shippingFee          Decimal               @default(0) @db.Decimal(10, 2)
  cashBankAccount      CashBankAccount?      @relation(fields: [cashBankAccountId], references: [id])
  supplier             Supplier?             @relation(fields: [supplierId], references: [id])
  user                 User                  @relation(fields: [userId], references: [id])
  items                PurchaseItem[]
  purchaseReturns      PurchaseReturn[]
  supplierPaymentItems SupplierPaymentItem[]

  @@index([cashBankAccountId])
  @@index([purchaseType])
}

model PurchaseItem {
  id             String            @id @default(cuid())
  purchaseId     String
  lineNo         Int               @default(0)
  productId      String
  supplierId     String?
  quantity       Int
  costPrice      Decimal           @db.Decimal(10, 2)
  totalAmount    Decimal           @db.Decimal(10, 2)
  landedCost     Decimal           @default(0) @db.Decimal(10, 2)
  subtotalAmount Decimal           @default(0) @db.Decimal(10, 2)
  product        Product           @relation(fields: [productId], references: [id])
  purchase       Purchase          @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  supplier       Supplier?         @relation(fields: [supplierId], references: [id])
  lotItems       PurchaseItemLot[]

  @@index([purchaseId, lineNo])
}

model Customer {
  id               String       @id @default(cuid())
  code             String?      @unique
  name             String
  phone            String?      @unique
  address          String?
  taxId            String?
  note             String?
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)
  shippingAddress  String?
  isActive         Boolean      @default(true)
  creditTerm       Int?
  lineLinkedAt     DateTime?    @db.Timestamptz(3)
  lineUserId       String?      @unique
  source           String       @default("ADMIN")
  defaultLatitude  Float?
  defaultLongitude Float?
  creditNotes      CreditNote[]
  receipts         Receipt[]
  sales            Sale[]

  @@index([name])
}

model Sale {
  id                      String                   @id @default(cuid())
  saleNo                  String                   @unique
  customerName            String?
  customerPhone           String?
  userId                  String
  totalAmount             Decimal                  @db.Decimal(10, 2)
  discount                Decimal                  @default(0) @db.Decimal(10, 2)
  netAmount               Decimal                  @db.Decimal(10, 2)
  paymentMethod           PaymentMethod?           @default(CASH)
  note                    String?
  saleDate                DateTime                 @default(now()) @db.Timestamptz(3)
  createdAt               DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @db.Timestamptz(3)
  customerId              String?
  saleType                SaleType                 @default(RETAIL)
  fulfillmentType         FulfillmentType          @default(PICKUP)
  shippingAddress         String?
  shippingFee             Decimal?                 @db.Decimal(10, 2)
  paymentType             SalePaymentType          @default(CASH_SALE)
  subtotalAmount          Decimal                  @default(0) @db.Decimal(10, 2)
  vatAmount               Decimal                  @default(0) @db.Decimal(10, 2)
  vatRate                 Decimal                  @default(0) @db.Decimal(5, 2)
  vatType                 VatType                  @default(NO_VAT)
  cancelNote              String?
  cancelledAt             DateTime?                @db.Timestamptz(3)
