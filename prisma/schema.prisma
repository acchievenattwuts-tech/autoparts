generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                            String                     @id @default(cuid())
  name                          String
  email                         String                     @unique
  password                      String
  role                          Role                       @default(STAFF)
  isActive                      Boolean                    @default(true)
  createdAt                     DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt                     DateTime                   @updatedAt @db.Timestamptz(3)
  appRoleId                     String?
  mustChangePassword            Boolean                    @default(false)
  username                      String?                    @unique
  signatureUpdatedAt            DateTime?                  @db.Timestamptz(3)
  signatureUrl                  String?
  phone                         String?
  adjustments                   Adjustment[]
  auditLogs                     AuditLog[]
  balanceForwards               BalanceForward[]
  cashBankAdjustments           CashBankAdjustment[]
  cashBankTransfers             CashBankTransfer[]
  contentApprovalsToReview      ContentApproval[]          @relation("ContentApprovalApprover")
  contentApprovalsRequested     ContentApproval[]          @relation("ContentApprovalRequestedBy")
  contentAuditLogs              ContentAuditLog[]          @relation("ContentAuditActor")
  contentPostsApproved          ContentPost[]              @relation("ContentPostApprovedBy")
  contentPostsCreated           ContentPost[]              @relation("ContentPostCreatedBy")
  contentScheduledJobsCreated   ContentScheduledJob[]      @relation("ContentScheduledJobCreatedBy")
  creditNotes                   CreditNote[]
  deliveryCommissionRuns        DeliveryCommissionRun[]    @relation("DeliveryCommissionStaff")
  deliveryCommissionRunsCreated DeliveryCommissionRun[]    @relation("DeliveryCommissionCreatedBy")
  deliveryProofs                DeliveryProof[]
  expenses                      Expense[]
  lineSummaryDispatches         LineDailySummaryDispatch[]
  lineConversationsAssigned     LineConversation[]         @relation("LineConversationAssignedAdmin")
  lineMessagesAdminAuthored     LineMessage[]              @relation("LineMessageAdminAuthor")
  paymentSlipsReviewed          PaymentSlip[]              @relation("PaymentSlipReviewer")
  profitExplanationHistories    ProfitExplanationHistory[]
  purchases                     Purchase[]
  purchaseReturns               PurchaseReturn[]
  receipts                      Receipt[]
  deliverySales                 Sale[]                     @relation("SaleDeliveryStaff")
  sales                         Sale[]
  notifications                 Notification[]
  shopeeShopsAuthorized         ShopeeShop[]
  supplierAdvances              SupplierAdvance[]
  supplierPayments              SupplierPayment[]
  appRole                       AppRole?                   @relation(fields: [appRoleId], references: [id])
  lineRecipientLinks            UserLineRecipient?

  @@index([username])
  @@index([appRoleId])
}

model LineRecipient {
  id            String              @id @default(cuid())
  lineId        String              @unique
  type          LineRecipientType
  status        LineRecipientStatus @default(ACTIVE)
  displayName   String?
  sourceName    String?
  sourceDetail  String?
  lastWebhookAt DateTime?           @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(3)
  userLinks     UserLineRecipient?

  @@index([type, status])
}

model UserLineRecipient {
  id          String        @id @default(cuid())
  userId      String        @unique
  recipientId String        @unique
  note        String?
  linkedAt    DateTime      @default(now()) @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
  recipient   LineRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([recipientId])
}

model LineDailySummaryDispatch {
  id                String                         @id @default(cuid())
  dispatchKey       String?                        @unique
  reportDayKey      String
  dispatchKind      LineDailySummaryDispatchKind
  status            LineDailySummaryDispatchStatus
  targetMode        LineDailySummaryTargetMode
  recipientCount    Int                            @default(0)
  sentCount         Int                            @default(0)
  recipientSnapshot String?
  errorMessage      String?
  sentAt            DateTime?                      @db.Timestamptz(3)
  createdAt         DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                       @updatedAt @db.Timestamptz(3)
  triggeredByUserId String?
  triggeredByUser   User?                          @relation(fields: [triggeredByUserId], references: [id])

  @@index([reportDayKey, dispatchKind])
  @@index([status, createdAt])
  @@index([triggeredByUserId])
}

model LineConversation {
  id                    String                   @id @default(cuid())
  lineUserId            String                   @unique
  displayName           String?
  pictureUrl            String?
  aiStatus              LineConversationAiStatus @default(ACTIVE)
  customerId            String?
  assignedAdminId       String?
  pausedReason          String?
  lastCustomerMessageAt DateTime?                @db.Timestamptz(3)
  lastAdminMessageAt    DateTime?                @db.Timestamptz(3)
  // Coalescing engine (debounce + abort-on-newer): lastInboundSeq is bumped on
  // every inbound customer message; lastProcessedSeq marks the seq up to which the
  // AI has already replied. The owner fields are a short-lived lock so only one
  // background worker processes a burst at a time (lease expiry lets a crashed
  // worker's lock be reclaimed; the cron failsafe picks up any orphaned jobs).
  lastInboundSeq        Int                      @default(0)
  lastProcessedSeq      Int                      @default(0)
  processingOwner       String?
  processingLeaseUntil  DateTime?                @db.Timestamptz(3)
  // Inquiry frame (conversation slot memory): the customer's CURRENT product
  // subject carried across turns so the AI continues the same inquiry without
  // re-asking. Reset on a topic shift (a new part type) or when the session goes
  // idle (see SESSION_IDLE_MS in lib/line-inquiry-frame.ts). inquiryUpdatedAt
  // stamps the last time the frame changed, used for staleness/session checks.
  inquiryPartType       String?
  inquiryCarBrand       String?
  inquiryCarModel       String?
  inquiryYear           Int?
  inquiryUpdatedAt      DateTime?                @db.Timestamptz(3)
  pausedAt              DateTime?                @db.Timestamptz(3)
  resumedAt             DateTime?                @db.Timestamptz(3)
  closedAt              DateTime?                @db.Timestamptz(3)
  createdAt             DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                 @updatedAt @db.Timestamptz(3)
  assignedAdmin         User?                    @relation("LineConversationAssignedAdmin", fields: [assignedAdminId], references: [id])
  customer              Customer?                @relation(fields: [customerId], references: [id])
  messages              LineMessage[]
  aiJobs                LineAiJob[]
  aiSuggestions         LineAiSuggestion[]
  auditLogs             LineAiAuditLog[]
  paymentSlips          PaymentSlip[]

  @@index([aiStatus, updatedAt])
  @@index([assignedAdminId])
  @@index([customerId])
  @@index([lastCustomerMessageAt])
}

model LineMessage {
  id             String               @id @default(cuid())
  conversationId String
  lineUserId     String
  lineMessageId  String?
  lineEventId    String?              @unique
  replyToken     String?
  direction      LineMessageDirection
  messageType    LineMessageType
  intent         LineIntent?
  text           String?
  imageUrl       String?
  rawEvent       Json?
  deliveryMode   LineDeliveryMode?
  deliveryStatus LineDeliveryStatus?
  adminUserId    String?
  sentAt         DateTime?            @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  adminUser      User?                @relation("LineMessageAdminAuthor", fields: [adminUserId], references: [id])
  conversation   LineConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  aiJobs         LineAiJob[]
  aiSuggestions  LineAiSuggestion[]

  @@index([conversationId, createdAt])
  @@index([lineUserId, createdAt])
  @@index([lineMessageId])
  @@index([direction, createdAt])
  @@index([intent, createdAt])
}

model LineAiJob {
  id             String           @id @default(cuid())
  conversationId String
  lineMessageId  String?
  jobType        LineAiJobType
  status         LineAiJobStatus  @default(PENDING)
  payload        Json?
  result         Json?
  error          String?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  startedAt      DateTime?        @db.Timestamptz(3)
  finishedAt     DateTime?        @db.Timestamptz(3)
  conversation   LineConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  lineMessage    LineMessage?     @relation(fields: [lineMessageId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([lineMessageId])
  @@index([jobType, status, createdAt])
}

model LineAiSuggestion {
  id               String                 @id @default(cuid())
  conversationId   String
  lineMessageId    String?
  intent           LineIntent?
  suggestedReply   String
  confidence       LineAiConfidence
  matchedProducts  Json?
  reasoningSummary String?
  status           LineAiSuggestionStatus @default(DRAFT)
  deliveryMode     LineDeliveryMode?
  createdAt        DateTime               @default(now()) @db.Timestamptz(3)
  sentAt           DateTime?              @db.Timestamptz(3)
  conversation     LineConversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  lineMessage      LineMessage?           @relation(fields: [lineMessageId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([lineMessageId])
  @@index([intent, confidence])
  @@index([status, createdAt])
}

model LineAiAuditLog {
  id             String            @id @default(cuid())
  conversationId String?
  action         String
  payload        Json?
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  conversation   LineConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([action, createdAt])
  @@index([conversationId, action, createdAt(sort: Desc)])
}

model PaymentSlip {
  id                       String                        @id @default(cuid())
  conversationId           String
  lineUserId               String
  lineMessageId            String?
  imageUrl                 String?
  detectedAmount           Decimal?                      @db.Decimal(10, 2)
  detectedTransferDatetime DateTime?                     @db.Timestamptz(3)
  detectedBank             String?
  detectedSenderName       String?
  detectedReceiverName     String?
  detectedReferenceNo      String?
  matchedSaleId            String?
  verificationStatus       PaymentSlipVerificationStatus @default(PENDING_REVIEW)
  rawOcr                   Json?
  imageSignedUrl           String?
  imageSignedUrlExpiresAt  DateTime?                     @db.Timestamptz(3)
  createdAt                DateTime                      @default(now()) @db.Timestamptz(3)
  reviewedAt               DateTime?                     @db.Timestamptz(3)
  reviewedById             String?
  conversation             LineConversation              @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  matchedSale              Sale?                         @relation(fields: [matchedSaleId], references: [id])
  reviewedBy               User?                         @relation("PaymentSlipReviewer", fields: [reviewedById], references: [id])

  @@index([conversationId, createdAt])
  @@index([lineUserId, createdAt])
  @@index([lineMessageId])
  @@index([matchedSaleId])
  @@index([verificationStatus, createdAt])
  @@index([reviewedById])
}

model AiApiKeyState {
  id             String           @id @default(cuid())
  keyRef         String           @unique
  provider       AiApiKeyProvider @default(GOOGLE_GEMINI)
  status         AiApiKeyStatus   @default(AVAILABLE)
  cooldownUntil  DateTime?        @db.Timestamptz(3)
  lastError      String?
  requestCount   Int              @default(0)
  successCount   Int              @default(0)
  errorCount     Int              @default(0)
  rateLimitCount Int              @default(0)
  lastUsedAt     DateTime?        @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  @@index([provider, status, cooldownUntil])
  @@index([provider, lastUsedAt])
}

model ProfitExplanationHistory {
  id            String                  @id @default(cuid())
  filterHash    String
  fromDate      String
  toDate        String
  basis         String
  requestedById String?
  promptVersion String
  keyRef        String?
  status        ProfitExplanationStatus @default(SUCCESS)
  evidence      Json
  result        Json?
  errorCode     String?
  errorMessage  String?
  createdAt     DateTime                @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime                @db.Timestamptz(3)
  requestedBy   User?                   @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([filterHash, createdAt])
  @@index([expiresAt])
  @@index([requestedById, createdAt])
}

model ContentPost {
  id                String                @id @default(cuid())
  channel           ContentChannel
  title             String?
  caption           String
  imageUrl          String?
  linkUrl           String?
  status            ContentPostStatus     @default(DRAFT)
  scheduledAt       DateTime?             @db.Timestamptz(3)
  approvedAt        DateTime?             @db.Timestamptz(3)
  postedAt          DateTime?             @db.Timestamptz(3)
  cancelledAt       DateTime?             @db.Timestamptz(3)
  failedAt          DateTime?             @db.Timestamptz(3)
  facebookPageId    String
  metaPostId        String?
  lastError         String?
  draftSource       String?
  timezone          String                @default("Asia/Bangkok")
  variantGroupId    String?
  variantNo         Int?
  isSelectedVariant Boolean               @default(false)
  createdByUserId   String
  approvedByUserId  String?
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)
  approvals         ContentApproval[]
  auditLogs         ContentAuditLog[]
  approvedByUser    User?                 @relation("ContentPostApprovedBy", fields: [approvedByUserId], references: [id])
  createdByUser     User                  @relation("ContentPostCreatedBy", fields: [createdByUserId], references: [id])
  scheduledJobs     ContentScheduledJob[]

  @@index([channel, status, scheduledAt])
  @@index([createdByUserId, createdAt])
  @@index([approvedByUserId])
  @@index([facebookPageId, status])
  @@index([postedAt])
  @@index([variantGroupId, variantNo])
}

model ContentApproval {
  id                String                @id @default(cuid())
  postId            String
  requestedByUserId String
  approverUserId    String
  status            ContentApprovalStatus @default(PENDING)
  requestNote       String?
  decisionNote      String?
  requestedAt       DateTime              @default(now()) @db.Timestamptz(3)
  actedAt           DateTime?             @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)
  approverUser      User                  @relation("ContentApprovalApprover", fields: [approverUserId], references: [id])
  post              ContentPost           @relation(fields: [postId], references: [id], onDelete: Cascade)
  requestedByUser   User                  @relation("ContentApprovalRequestedBy", fields: [requestedByUserId], references: [id])

  @@index([postId, status])
  @@index([approverUserId, status, requestedAt])
  @@index([requestedByUserId])
}

model ContentScheduledJob {
  id                String                    @id @default(cuid())
  postId            String
  type              ContentScheduledJobType
  status            ContentScheduledJobStatus @default(PENDING)
  provider          String
  providerMessageId String?
  idempotencyKey    String                    @unique
  runAt             DateTime                  @db.Timestamptz(3)
  startedAt         DateTime?                 @db.Timestamptz(3)
  finishedAt        DateTime?                 @db.Timestamptz(3)
  attemptCount      Int                       @default(0)
  maxAttempts       Int                       @default(3)
  lastError         String?
  payloadJson       String?
  createdByUserId   String?
  createdAt         DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                  @updatedAt @db.Timestamptz(3)
  createdByUser     User?                     @relation("ContentScheduledJobCreatedBy", fields: [createdByUserId], references: [id])
  post              ContentPost               @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([postId, type, status])
  @@index([provider, providerMessageId])
  @@index([createdByUserId])
}

model ContentAuditLog {
  id               String                   @id @default(cuid())
  postId           String
  actorUserId      String?
  action           String
  detail           String?
  metadataJson     String?
  notificationType ContentNotificationType?
  createdAt        DateTime                 @default(now()) @db.Timestamptz(3)
  actorUser        User?                    @relation("ContentAuditActor", fields: [actorUserId], references: [id])
  post             ContentPost              @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  userName   String?
  userRole   String?
  action     AuditAction
  entityType String
  entityId   String?
  entityRef  String?
  before     Json?
  after      Json?
  meta       Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  user       User?       @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

model LoginThrottle {
  key            String    @id
  failures       Int       @default(0)
  firstFailureAt DateTime? @db.Timestamptz(3)
  lockedUntil    DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
}

model ApiThrottle {
  key       String   @id
  count     Int      @default(0)
  windowEnd DateTime @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([windowEnd])
}

model AppRole {
  id          String              @id @default(cuid())
  name        String              @unique
  description String?
  isSystem    Boolean             @default(false)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  permissions AppRolePermission[]
  users       User[]
}

model Permission {
  id          String              @id @default(cuid())
  key         String              @unique
  group       String
  label       String
  description String?
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  roles       AppRolePermission[]
}

model AppRolePermission {
  appRoleId    String
  permissionId String
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  appRole      AppRole    @relation(fields: [appRoleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([appRoleId, permissionId])
  @@index([permissionId])
}

model CarBrand {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  isActive  Boolean    @default(true)
  carModels CarModel[]
}

model CarModel {
  id         String           @id @default(cuid())
  name       String
  carBrandId String
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  isActive   Boolean          @default(true)
  carBrand   CarBrand         @relation(fields: [carBrandId], references: [id])
  products   ProductFitment[]

  @@unique([name, carBrandId])
  @@index([carBrandId])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  isActive  Boolean   @default(true)
  slug      String?   @unique
  aliases   CategoryAlias[]
  products  Product[]
}

enum CategoryAliasKind {
  MATCH
  SKIP_CATEGORY
}

enum CategoryAliasMatchMode {
  EXACT
  CONTAINS
  TOKEN
}

model CategoryAlias {
  id         String                 @id @default(cuid())
  categoryId String?
  alias      String
  kind       CategoryAliasKind      @default(MATCH)
  matchMode  CategoryAliasMatchMode @default(CONTAINS)
  priority   Int                    @default(0)
  isActive   Boolean                @default(true)
  notes      String?
  createdAt  DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime               @updatedAt @db.Timestamptz(3)
  category   Category?              @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([alias, kind])
  @@index([categoryId])
  @@index([kind, isActive, priority])
}

model Supplier {
  id                String            @id @default(cuid())
  name              String            @unique
  contactName       String?
  phone             String?
  address           String?
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  code              String?           @unique
  isActive          Boolean           @default(true)
  taxId             String?
  creditTerm        Int?
  preferredProducts Product[]         @relation("ProductPreferredSupplier")
  purchases         Purchase[]
  purchaseItems     PurchaseItem[]
  purchaseReturns   PurchaseReturn[]
  supplierAdvances  SupplierAdvance[]
  supplierPayments  SupplierPayment[]
  warrantyClaims    WarrantyClaim[]
}

model PartsBrand {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  isActive  Boolean   @default(true)
  products  Product[]
}

model Product {
  id                  String                 @id @default(cuid())
  code                String                 @unique
  name                String
  description         String?
  categoryId          String
  shelfLocation       String?
  costPrice           Decimal                @default(0) @db.Decimal(10, 2)
  purchaseLastPrice   Decimal?               @db.Decimal(10, 2)
  purchaseLastDate    DateTime?              @db.Timestamptz(3)
  salePrice           Decimal                @default(0) @db.Decimal(10, 2)
  stock               Int                    @default(0)
  minStock            Int                    @default(1)
  imageUrl            String?
  isActive            Boolean                @default(true)
  createdAt           DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @db.Timestamptz(3)
  purchaseUnitName    String                 @default("ชิ้น")
  reportUnitName      String                 @default("ชิ้น")
  saleUnitName        String                 @default("ชิ้น")
  brandId             String?
  avgCost             Decimal                @default(0) @db.Decimal(10, 2)
  warrantyDays        Int                    @default(0)
  preferredSupplierId String?
  allowExpiredIssue   Boolean                @default(false)
  isLotControl        Boolean                @default(false)
  lotIssueMethod      LotIssueMethod         @default(FIFO)
  requireExpiryDate   Boolean                @default(false)
  slug                String?                @unique
  inventoryTracking   InventoryTracking      @default(TRACKED)
  adjustmentItems     AdjustmentItem[]
  balanceForwards     BalanceForward[]
  claimStockBalances  ClaimStockBalance[]
  claimStockMovements ClaimStockMovement[]
  creditNoteItems     CreditNoteItem[]
  lotBalances         LotBalance[]
  brand               PartsBrand?            @relation(fields: [brandId], references: [id])
  category            Category               @relation(fields: [categoryId], references: [id])
  preferredSupplier   Supplier?              @relation("ProductPreferredSupplier", fields: [preferredSupplierId], references: [id])
  aliases             ProductAlias[]
  carModels           ProductFitment[]
  images              ProductImage[]
  lots                ProductLot[]
  units               ProductUnit[]
  purchaseItems       PurchaseItem[]
  purchaseReturnItems PurchaseReturnItem[]
  saleItems           SaleItem[]
  shopeeMappings      ShopeeProductMapping[]
  stockCards          StockCard[]
  warranties          Warranty[]

  @@index([categoryId])
  @@index([brandId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([productId, isPrimary])
}

model ProductUnit {
  id             String                 @id @default(cuid())
  productId      String
  name           String
  scale          Float
  isBase         Boolean                @default(false)
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  product        Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  shopeeMappings ShopeeProductMapping[]

  @@unique([productId, name])
}

model ProductAlias {
  id        String    @id @default(cuid())
  productId String
  alias     String
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  kind      AliasKind @default(ALIAS)
  weight    Int?
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, alias, kind])
  @@index([alias])
  @@index([kind])
}

/// Global search synonym dictionary (Phase D).
/// Bi-directional: a query matching `term` OR any item in `synonyms[]` will expand to cover all related terms.
model SearchSynonym {
  id        String   @id @default(cuid())
  term      String   @unique
  synonyms  String[] @default([])
  language  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([isActive])
}

model ProductSearchLog {
  id          String   @id @default(cuid())
  query       String   @db.VarChar(200)
  filters     Json?
  resultCount Int      @default(0)
  source      String   @db.VarChar(30)
  path        String?  @db.VarChar(200)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  dedupeKey   String?  @unique @db.VarChar(280)
  hitCount    Int      @default(1)
  isBot       Boolean  @default(false)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([createdAt(sort: Desc)])
  @@index([source, createdAt(sort: Desc)])
  @@index([resultCount, createdAt(sort: Desc)])
  @@index([isBot, createdAt(sort: Desc)])
}

model ProductSearchReviewOutcome {
  id               String                    @id @default(cuid())
  normalizedQuery  String                    @db.VarChar(200)
  candidateAction  String                    @db.VarChar(50)
  status           ProductSearchReviewStatus @default(PENDING)
  note             String?                   @db.VarChar(500)
  appliedType      String?                   @db.VarChar(50)
  appliedRef       String?                   @db.VarChar(100)
  reviewedById     String?
  reviewedByName   String?                   @db.VarChar(100)
  reviewedAt       DateTime?                 @db.Timestamptz(3)
  createdAt        DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                  @updatedAt @db.Timestamptz(3)
  baselineCount    Int?
  baselineAvg      Float?
  baselineLatestAt DateTime?                 @db.Timestamptz(3)
  baselineSources  Json?

  @@unique([normalizedQuery, candidateAction])
  @@index([status, updatedAt(sort: Desc)])
  @@index([reviewedAt(sort: Desc)])
}

model ProductSearchClusterCache {
  id               String   @id @default(cuid())
  windowKey        String   @db.VarChar(20)
  normalizedQuery  String   @db.VarChar(200)
  candidateAction  String   @db.VarChar(50)
  bucket           String   @db.VarChar(20)
  count            Int
  minResultCount   Int
  avgResultCount   Decimal  @db.Decimal(10, 2)
  latestAt         DateTime @db.Timestamptz(3)
  rawQueriesSample Json
  sourceCounts     Json
  windowStart      DateTime @db.Timestamptz(3)
  windowEnd        DateTime @db.Timestamptz(3)
  computedAt       DateTime @default(now()) @db.Timestamptz(3)

  @@unique([windowKey, normalizedQuery, candidateAction])
  @@index([windowKey, computedAt])
}

model ProductFitment {
  productId   String
  carModelId  String
  id          String             @id @default(cuid())
  fitmentType ProductFitmentType @default(DIRECT)
  submodel    String?
  yearStart   Int?
  yearEnd     Int?
  engineCode  String?
  engineSize  String?
  note        String?
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  carModel    CarModel           @relation(fields: [carModelId], references: [id])
  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, carModelId, submodel, yearStart, yearEnd, engineCode, fitmentType])
  @@index([carModelId, productId])
  @@index([carModelId, yearStart, yearEnd])
  @@index([productId, fitmentType])
  @@map("ProductCarModel")
}

model StockCard {
  id                  String               @id @default(cuid())
  productId           String
  docNo               String
  docDate             DateTime             @db.Timestamptz(3)
  source              StockCardSource
  sorder              Int
  qtyIn               Decimal              @default(0) @db.Decimal(12, 4)
  qtyOut              Decimal              @default(0) @db.Decimal(12, 4)
  qtyBalance          Decimal              @default(0) @db.Decimal(12, 4)
  priceIn             Decimal              @default(0) @db.Decimal(10, 4)
  priceOut            Decimal              @default(0) @db.Decimal(10, 4)
  priceBalance        Decimal              @default(0) @db.Decimal(10, 4)
  detail              String?
  referenceId         String?
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  landedCost          Decimal              @default(0) @db.Decimal(10, 2)
  usesReferenceCost   Boolean              @default(false)
  claimStockMovements ClaimStockMovement[]
  product             Product              @relation(fields: [productId], references: [id])
  lotMovements        StockMovementLot[]

  @@index([productId, docDate, sorder])
  @@index([docNo])
}

model BalanceForward {
  id              String    @id @default(cuid())
  docNo           String    @unique
  docDate         DateTime  @db.Timestamptz(3)
  productId       String
  unitName        String
  qtyInBase       Decimal   @db.Decimal(12, 4)
  costPerBaseUnit Decimal   @db.Decimal(10, 4)
  note            String?
  status          DocStatus @default(ACTIVE)
  cancelledAt     DateTime? @db.Timestamptz(3)
  cancelNote      String?
  userId          String
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  product         Product   @relation(fields: [productId], references: [id])
  user            User      @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([docDate])
}

model Purchase {
  id                   String                @id @default(cuid())
  purchaseNo           String                @unique
  supplierId           String?
  userId               String
  totalAmount          Decimal               @db.Decimal(10, 2)
  discount             Decimal               @default(0) @db.Decimal(10, 2)
  netAmount            Decimal               @db.Decimal(10, 2)
  note                 String?
  purchaseDate         DateTime              @default(now()) @db.Timestamptz(3)
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  referenceNo          String?
  subtotalAmount       Decimal               @default(0) @db.Decimal(10, 2)
  vatAmount            Decimal               @default(0) @db.Decimal(10, 2)
  vatRate              Decimal               @default(0) @db.Decimal(5, 2)
  vatType              VatType               @default(NO_VAT)
  cancelNote           String?
  cancelledAt          DateTime?             @db.Timestamptz(3)
  status               DocStatus             @default(ACTIVE)
  amountRemain         Decimal               @default(0) @db.Decimal(10, 2)
  paymentMethod        PaymentMethod         @default(TRANSFER)
  cashBankAccountId    String?
  paymentStatus        PurchasePaymentStatus @default(UNPAID)
  purchaseType         PurchaseType          @default(CREDIT_PURCHASE)
  creditTerm           Int?
  shippingFee          Decimal               @default(0) @db.Decimal(10, 2)
  cashBankAccount      CashBankAccount?      @relation(fields: [cashBankAccountId], references: [id])
  supplier             Supplier?             @relation(fields: [supplierId], references: [id])
  user                 User                  @relation(fields: [userId], references: [id])
  items                PurchaseItem[]
  purchaseReturns      PurchaseReturn[]
  supplierPaymentItems SupplierPaymentItem[]

  @@index([cashBankAccountId])
  @@index([purchaseType])
  @@index([purchaseDate(sort: Desc), status])
}

model PurchaseItem {
  id               String            @id @default(cuid())
  purchaseId       String
  lineNo           Int               @default(0)
  productId        String
  supplierId       String?
  quantity         Int
  costPrice        Decimal           @db.Decimal(10, 2)
  totalAmount      Decimal           @db.Decimal(10, 2)
  landedCost       Decimal           @default(0) @db.Decimal(10, 2)
  subtotalAmount   Decimal           @default(0) @db.Decimal(10, 2)
  showQty          Decimal?          @db.Decimal(12, 4)
  showUnitName     String?
  showPricePerUnit Decimal?          @db.Decimal(10, 2)
  unitScale        Decimal?          @db.Decimal(12, 4)
  product          Product           @relation(fields: [productId], references: [id])
  purchase         Purchase          @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  supplier         Supplier?         @relation(fields: [supplierId], references: [id])
  lotItems         PurchaseItemLot[]

  @@index([purchaseId, lineNo])
}

model Customer {
  id               String       @id @default(cuid())
  code             String?      @unique
  name             String
  phone            String?      @unique
  address          String?
  taxId            String?
  note             String?
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)
  shippingAddress  String?
  isActive         Boolean      @default(true)
  creditTerm       Int?
  lineLinkedAt     DateTime?    @db.Timestamptz(3)
  lineUserId       String?      @unique
  source           String       @default("ADMIN")
  defaultLatitude  Float?
  defaultLongitude Float?
  lineConversations LineConversation[]
  creditNotes      CreditNote[]
  receipts         Receipt[]
  sales            Sale[]
  warranties       Warranty[]

  @@index([name])
  @@index([lineLinkedAt])
}

model Sale {
  id                      String                   @id @default(cuid())
  saleNo                  String                   @unique
  customerName            String?
  customerPhone           String?
  userId                  String
  totalAmount             Decimal                  @db.Decimal(10, 2)
  discount                Decimal                  @default(0) @db.Decimal(10, 2)
  netAmount               Decimal                  @db.Decimal(10, 2)
  paymentMethod           PaymentMethod?           @default(CASH)
  note                    String?
  saleDate                DateTime                 @default(now()) @db.Timestamptz(3)
  createdAt               DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @db.Timestamptz(3)
  customerId              String?
  saleType                SaleType                 @default(RETAIL)
  fulfillmentType         FulfillmentType          @default(PICKUP)
  shippingAddress         String?
  shippingFee             Decimal?                 @db.Decimal(10, 2)
  paymentType             SalePaymentType          @default(CASH_SALE)
  subtotalAmount          Decimal                  @default(0) @db.Decimal(10, 2)
  vatAmount               Decimal                  @default(0) @db.Decimal(10, 2)
  vatRate                 Decimal                  @default(0) @db.Decimal(5, 2)
  vatType                 VatType                  @default(NO_VAT)
  cancelNote              String?
  cancelledAt             DateTime?                @db.Timestamptz(3)
  status                  DocStatus                @default(ACTIVE)
  channel                 SaleChannel              @default(STORE)
  channelRefNo            String?
  amountRemain            Decimal                  @default(0) @db.Decimal(10, 2)
  shippingMethod          ShippingMethod           @default(NONE)
  shippingStatus          ShippingStatus           @default(PENDING)
  trackingNo              String?
  cashBankAccountId       String?
  creditTerm              Int?
  signedAt                DateTime?                @db.Timestamptz(3)
  signerName              String?
  signerSignatureUrl      String?
  deliveryQueueOrder      Int?
  deliveryStaffId         String?
  trackingExpiry          DateTime?                @db.Timestamptz(3)
  trackingToken           String?                  @unique
  destLatitude            Float?
  destLongitude           Float?
  creditNotes             CreditNote[]
  deliveryCommissionItems DeliveryCommissionItem[]
  deliveryProofs          DeliveryProof[]
  deliveryTracking        DeliveryTracking?
  receipts                ReceiptItem[]
  cashBankAccount         CashBankAccount?         @relation(fields: [cashBankAccountId], references: [id])
  customer                Customer?                @relation(fields: [customerId], references: [id])
  deliveryStaff           User?                    @relation("SaleDeliveryStaff", fields: [deliveryStaffId], references: [id])
  user                    User                     @relation(fields: [userId], references: [id])
  items                   SaleItem[]
  warranties              Warranty[]
  paymentSlips            PaymentSlip[]
  shopeeOrderImport       ShopeeOrderImport?

  @@index([cashBankAccountId])
  @@index([trackingToken])
  @@index([trackingExpiry])
  @@index([deliveryStaffId, shippingStatus, status])
  @@index([deliveryStaffId, fulfillmentType, status, shippingStatus, saleDate, saleNo])
  @@index([fulfillmentType, status, shippingStatus, deliveryQueueOrder])
  @@index([fulfillmentType, status, shippingStatus, saleDate, saleNo])
  @@index([customerId, status, saleDate(sort: Desc)])
  @@index([customerId, paymentType, status, amountRemain])
  @@index([saleDate(sort: Desc), status])
  @@index([channel, status, saleDate])
  @@index([channelRefNo])
}

model DeliveryProof {
  id                String   @id @default(cuid())
  saleId            String
  receiverName      String?
  signatureImageUrl String?
  deliveryPhotoUrl  String?
  note              String?
  capturedAt        DateTime @default(now()) @db.Timestamptz(3)
  capturedByUserId  String?
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
  capturedByUser    User?    @relation(fields: [capturedByUserId], references: [id])
  sale              Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId, capturedAt])
  @@index([capturedByUserId])
}

model DeliveryTracking {
  id        String   @id @default(cuid())
  saleId    String   @unique
  latitude  Float
  longitude Float
  accuracy  Float
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([updatedAt])
}

model SaleItem {
  id               String        @id @default(cuid())
  saleId           String
  lineNo           Int           @default(0)
  productId        String
  quantity         Int
  salePrice        Decimal       @db.Decimal(10, 2)
  costPrice        Decimal       @db.Decimal(10, 2)
  totalAmount      Decimal       @db.Decimal(10, 2)
  subtotalAmount   Decimal       @default(0) @db.Decimal(10, 2)
  showQty          Decimal?      @db.Decimal(12, 4)
  showUnitName     String?
  showPricePerUnit Decimal?      @db.Decimal(10, 2)
  unitScale        Decimal?      @db.Decimal(12, 4)
  warrantyDays     Int           @default(0)
  supplierId       String?
  supplierName     String?
  product          Product       @relation(fields: [productId], references: [id])
  sale             Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  lotItems         SaleItemLot[]
  warranties       Warranty[]

  @@index([saleId, lineNo])
  @@index([productId])
}

model Warranty {
  id           String                 @id @default(cuid())
  saleId       String?
  saleItemId   String?
  productId    String
  customerId   String?
  customerName String?
  startDate    DateTime               @db.Timestamptz(3)
  endDate      DateTime               @db.Timestamptz(3)
  note         String?
  createdAt    DateTime               @default(now()) @db.Timestamptz(3)
  warrantyDays Int
  unitSeq      Int                    @default(1)
  lotNo        String?
  createdVia   WarrantyCreationSource @default(AUTO_FROM_SALE)
  product      Product                @relation(fields: [productId], references: [id])
  sale         Sale?                  @relation(fields: [saleId], references: [id])
  saleItem     SaleItem?              @relation(fields: [saleItemId], references: [id])
  customer     Customer?              @relation(fields: [customerId], references: [id])
  claims       WarrantyClaim[]

  @@unique([saleItemId, unitSeq])
  @@index([productId])
  @@index([endDate])
  @@index([saleId, endDate])
  @@index([customerId])
  @@index([createdVia])
}

enum WarrantyCreationSource {
  AUTO_FROM_SALE
  MANUAL
}

model WarrantyClaim {
  id                  String               @id @default(cuid())
  claimNo             String               @unique
  warrantyId          String
  claimDate           DateTime             @db.Timestamptz(3)
  claimType           ClaimType
  status              WarrantyClaimStatus  @default(DRAFT)
  outcome             ClaimOutcome?
  symptom             String?
  note                String?
  supplierId          String?
  supplierName        String?
  supplierPhone       String?
  supplierAddress     String?
  sentAt              DateTime?            @db.Timestamptz(3)
  resolvedAt          DateTime?            @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  returnedAt          DateTime?            @db.Timestamptz(3)
  signedAt            DateTime?            @db.Timestamptz(3)
  signerName          String?
  signerSignatureUrl  String?
  claimStockBalances  ClaimStockBalance[]
  claimStockMovements ClaimStockMovement[]
  purchaseReturns     PurchaseReturn[]
  supplier            Supplier?            @relation(fields: [supplierId], references: [id])
  warranty            Warranty             @relation(fields: [warrantyId], references: [id])
  claimLots           WarrantyClaimLot[]

  @@index([warrantyId])
  @@index([claimDate])
  @@index([status])
  @@index([warrantyId, claimDate(sort: Desc)])
  @@index([warrantyId, status])
}

model ClaimStockBalance {
  id        String        @id @default(cuid())
  claimId   String
  productId String
  lotNo     String        @default("")
  qtyOnHand Decimal       @default(0) @db.Decimal(12, 4)
  unitCost  Decimal       @default(0) @db.Decimal(10, 2)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)
  claim     WarrantyClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id])

  @@unique([claimId, productId, lotNo])
  @@index([productId])
  @@index([claimId])
}

model ClaimStockMovement {
  id               String                 @id @default(cuid())
  claimId          String
  productId        String
  movementType     ClaimStockMovementType
  docNo            String
  docDate          DateTime               @db.Timestamptz(3)
  lotNo            String                 @default("")
  qtyIn            Decimal                @default(0) @db.Decimal(12, 4)
  qtyOut           Decimal                @default(0) @db.Decimal(12, 4)
  unitCost         Decimal                @default(0) @db.Decimal(10, 2)
  detail           String?
  stockCardId      String?
  purchaseReturnId String?
  reversalOfId     String?
  reversedAt       DateTime?              @db.Timestamptz(3)
  createdAt        DateTime               @default(now()) @db.Timestamptz(3)
  claim            WarrantyClaim          @relation(fields: [claimId], references: [id], onDelete: Cascade)
  product          Product                @relation(fields: [productId], references: [id])
  stockCard        StockCard?             @relation(fields: [stockCardId], references: [id])

  @@index([claimId, docDate])
  @@index([docDate, movementType])
  @@index([productId])
  @@index([movementType])
  @@index([stockCardId])
  @@index([purchaseReturnId])
}

model WarrantyClaimLot {
  id        String        @id @default(cuid())
  claimId   String
  lotNo     String
  qty       Decimal       @db.Decimal(12, 4)
  direction String
  unitCost  Decimal       @db.Decimal(10, 4)
  claim     WarrantyClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([lotNo])
}

model ExpenseCode {
  id                     String                  @id @default(cuid())
  code                   String                  @unique
  name                   String
  description            String?
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now()) @db.Timestamptz(3)
  isDeliveryCommission   Boolean                 @default(false)
  deliveryCommissionSlot String?                 @unique
  deliveryCommissionRuns DeliveryCommissionRun[]
  items                  ExpenseItem[]
}

model Expense {
  id                    String                 @id @default(cuid())
  userId                String
  expenseDate           DateTime               @db.Timestamptz(3)
  note                  String?
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)
  subtotalAmount        Decimal                @default(0) @db.Decimal(10, 2)
  vatAmount             Decimal                @default(0) @db.Decimal(10, 2)
  vatRate               Decimal                @default(0) @db.Decimal(5, 2)
  vatType               VatType                @default(NO_VAT)
  cancelNote            String?
  cancelledAt           DateTime?              @db.Timestamptz(3)
  expenseNo             String                 @unique
  netAmount             Decimal                @db.Decimal(10, 2)
  status                DocStatus              @default(ACTIVE)
  totalAmount           Decimal                @db.Decimal(10, 2)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(3)
  cashBankAccountId     String?
  deliveryCommissionRun DeliveryCommissionRun?
  cashBankAccount       CashBankAccount?       @relation(fields: [cashBankAccountId], references: [id])
  shopeeEscrowOrder     ShopeeOrderImport?     @relation("ShopeeEscrowExpense")
  user                  User                   @relation(fields: [userId], references: [id])
  items                 ExpenseItem[]

  @@index([cashBankAccountId])
  @@index([expenseDate(sort: Desc), status])
  @@index([cashBankAccountId, expenseDate(sort: Desc), status])
}

model DeliveryCommissionRun {
  id                String                   @id @default(cuid())
  runNo             String                   @unique
  payDate           DateTime                 @db.Timestamptz(3)
  fromDate          DateTime                 @db.Timestamptz(3)
  toDate            DateTime                 @db.Timestamptz(3)
  deliveryStaffId   String
  userId            String
  cashBankAccountId String
  expenseCodeId     String
  expenseId         String?                  @unique
  commissionPercent Decimal                  @db.Decimal(5, 2)
  shippingFeeTotal  Decimal                  @default(0) @db.Decimal(10, 2)
  commissionTotal   Decimal                  @default(0) @db.Decimal(10, 2)
  note              String?
  status            DocStatus                @default(ACTIVE)
  cancelNote        String?
  cancelledAt       DateTime?                @db.Timestamptz(3)
  createdAt         DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @db.Timestamptz(3)
  items             DeliveryCommissionItem[]
  cashBankAccount   CashBankAccount          @relation(fields: [cashBankAccountId], references: [id])
  deliveryStaff     User                     @relation("DeliveryCommissionStaff", fields: [deliveryStaffId], references: [id])
  expenseCode       ExpenseCode              @relation(fields: [expenseCodeId], references: [id])
  expense           Expense?                 @relation(fields: [expenseId], references: [id])
  user              User                     @relation("DeliveryCommissionCreatedBy", fields: [userId], references: [id])

  @@index([payDate, status])
  @@index([deliveryStaffId, status, payDate])
  @@index([expenseId])
}

model DeliveryCommissionItem {
  id                String                @id @default(cuid())
  runId             String
  lineNo            Int                   @default(0)
  saleId            String
  saleNo            String
  saleDate          DateTime              @db.Timestamptz(3)
  customerName      String?
  shippingFee       Decimal               @db.Decimal(10, 2)
  commissionPercent Decimal               @db.Decimal(5, 2)
  commissionAmount  Decimal               @db.Decimal(10, 2)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  activeSaleId      String?               @unique
  run               DeliveryCommissionRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sale              Sale                  @relation(fields: [saleId], references: [id])

  @@unique([runId, saleId])
  @@index([runId, lineNo])
  @@index([saleId])
}

model ExpenseItem {
  id            String      @id @default(cuid())
  expenseId     String
  lineNo        Int         @default(0)
  expenseCodeId String
  description   String?
  amount        Decimal     @db.Decimal(10, 2)
  expenseCode   ExpenseCode @relation(fields: [expenseCodeId], references: [id])
  expense       Expense     @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId, lineNo])
}

model FactProfit {
  id                  String           @id @default(cuid())
  businessDate        DateTime         @db.Timestamptz(3)
  sourceType          ProfitSourceType
  channel             SaleChannel?
  sourceSubtype       String?
  sourceId            String
  sourceLineId        String?
  sourceDocNo         String
  referenceDocNo      String?
  sourceStatus        DocStatus        @default(ACTIVE)
  isActive            Boolean          @default(true)
  versionNo           Int              @default(1)
  productId           String?
  productCode         String?
  productName         String?
  customerId          String?
  customerName        String?
  supplierId          String?
  supplierName        String?
  lineLabel           String?
  quantity            Decimal          @default(0) @db.Decimal(12, 4)
  salesAmount         Decimal          @default(0) @db.Decimal(10, 2)
  costAmount          Decimal          @default(0) @db.Decimal(10, 2)
  expenseAmount       Decimal          @default(0) @db.Decimal(10, 2)
  grossProfit         Decimal          @default(0) @db.Decimal(10, 2)
  netProfitAmount     Decimal          @default(0) @db.Decimal(10, 2)
  unitSalePrice       Decimal          @default(0) @db.Decimal(10, 2)
  unitCostPrice       Decimal          @default(0) @db.Decimal(10, 2)
  unitProfit          Decimal          @default(0) @db.Decimal(10, 2)
  marginPct           Decimal          @default(0) @db.Decimal(7, 2)
