{
  "name": "autoparts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build --webpack",
    "analyze": "set ANALYZE=true&& set NODE_OPTIONS=--max-old-space-size=4096&& next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "codex:skill:install": "node scripts/install-codex-skill.mjs",
    "codex:skill:install:seo-aio": "node scripts/install-codex-skill.mjs seo-aio",
    "codex:skill:install:all": "node scripts/install-codex-skill.mjs --all",
    "postinstall": "prisma generate && node scripts/setup-git-hooks.mjs",
    "check:mojibake": "node scripts/check-mojibake.mjs",
    "seed": "npx tsx --env-file=.env.local prisma/seed.ts",
    "test:admin-theme-regression": "tsx scripts/test-admin-theme-regression.ts",
    "test:security-hardening": "node scripts/test-security-hardening.mjs",
    "test:primary-transfer-roadmap": "tsx scripts/test-primary-transfer-roadmap.ts",
    "test:stock-card-sequence": "tsx scripts/test-stock-card-sequence.ts",
    "test:roadmap-2026-04-27": "tsx scripts/test-roadmap-2026-04-27.ts",
    "test:semantic-golden": "tsx --env-file=.env.local scripts/test-semantic-search-golden.ts",
    "evaluate:semantic-retrieval": "tsx --env-file=.env.local scripts/evaluate-semantic-retrieval.ts",
    "diagnose:semantic-query": "tsx --env-file=.env.local scripts/diagnose-semantic-query.ts",
    "experiment:semantic-embedding-text": "tsx --env-file=.env.local scripts/experiment-semantic-embedding-text.ts",
    "experiment:semantic-or-merge": "tsx --env-file=.env.local scripts/experiment-semantic-or-merge.ts",
    "test:messenger-webhook": "node --experimental-test-module-mocks --import tsx --test lib/messenger/__tests__/messenger-webhook-processor.test.ts lib/messenger/__tests__/messenger-image-gate.test.ts lib/messenger/__tests__/messenger-vehicle-unresolved.test.ts",
    "db:backup": "tsx --env-file=.env prisma/scripts/db-backup.ts",
    "db:restore": "tsx --env-file=.env prisma/scripts/db-restore.ts",
    "db:push": "prisma db push && tsx --env-file=.env.local prisma/scripts/setup-search-v2.ts && tsx --env-file=.env.local prisma/scripts/setup-knowledge-rag.ts",
    "db:push:accept-data-loss": "prisma db push --accept-data-loss && tsx --env-file=.env.local prisma/scripts/setup-search-v2.ts && tsx --env-file=.env.local prisma/scripts/setup-knowledge-rag.ts",
    "db:setup-search-v2": "tsx --env-file=.env.local prisma/scripts/setup-search-v2.ts",
    "db:setup-knowledge-rag": "tsx --env-file=.env.local prisma/scripts/setup-knowledge-rag.ts",
    "backfill:knowledge-rag": "tsx --env-file=.env.local prisma/scripts/backfill-knowledge-rag.ts",
    "migrate:knowledge-cms": "tsx --env-file=.env.local prisma/scripts/migrate-knowledge-cms.ts",
    "backfill:knowledge-quality": "tsx --env-file=.env.local prisma/scripts/backfill-knowledge-quality.ts",
    "check:knowledge-rag": "tsx --env-file=.env.local prisma/scripts/check-knowledge-rag.ts",
    "evaluate:knowledge-rag": "tsx --env-file=.env.local prisma/scripts/evaluate-knowledge-rag-retrieval.ts",
    "aggregate:knowledge-rag-telemetry": "tsx prisma/scripts/aggregate-knowledge-rag-telemetry.ts",
    "check:knowledge-cms": "tsx --env-file=.env.local prisma/scripts/check-knowledge-cms.ts",
    "check:search-v2-health": "tsx --env-file=.env.local prisma/scripts/check-search-v2-health.ts",
    "evaluate:search-v2": "tsx --env-file=.env.local prisma/scripts/evaluate-search-v2.ts",
    "refresh:search-popularity": "tsx --env-file=.env.local prisma/scripts/refresh-search-popularity.ts",
    "refresh:search-keywords": "tsx --env-file=.env.local prisma/scripts/refresh-search-keywords.ts",
    "backfill:fact-profit": "tsx --env-file=.env prisma/scripts/backfill-fact-profit.ts",
    "backfill:fact-profit-channel": "tsx --env-file=.env prisma/scripts/backfill-fact-profit-channel.ts",
    "backfill:claim-stock": "tsx --env-file=.env prisma/scripts/backfill-claim-stock.ts",
    "backfill:embeddings": "tsx --env-file=.env.local prisma/scripts/backfill-embeddings.ts",
    "backfill:public-images-blob": "tsx --env-file=.env.local prisma/scripts/backfill-public-images-to-blob.ts",
    "backfill:payment-slips-blob": "tsx --env-file=.env.local prisma/scripts/backfill-payment-slips-to-blob.ts",
    "sweep:blob-orphans": "tsx --env-file=.env.local prisma/scripts/sweep-blob-product-orphans.ts",
    "cleanup:supabase-storage": "tsx --env-file=.env.local prisma/scripts/delete-supabase-storage-objects.ts",
    "reconcile:fact-profit": "tsx --env-file=.env prisma/scripts/reconcile-fact-profit.ts",
    "enable:fact-profit-rls": "tsx --env-file=.env prisma/scripts/enable-profit-fact-rls.ts",
    "enable:claim-stock-rls": "tsx --env-file=.env prisma/scripts/enable-claim-stock-rls.ts"
  },
  "prisma": {
    "seed": "npx tsx --env-file=.env.local prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.5.0",
    "@supabase/supabase-js": "^2.100.0",
    "@types/leaflet": "^1.9.21",
    "@types/node-cron": "^3.0.11",
    "@upstash/qstash": "^2.10.1",
    "@vercel/blob": "^2.4.1",
    "bcryptjs": "^3.0.3",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.0.1",
    "next": "16.2.1",
    "next-auth": "^5.0.0-beta.30",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "promptpay-qr": "^0.5.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-image-crop": "^11.0.10",
    "recharts": "^3.8.1",
    "shadcn": "^4.1.0",
    "sharp": "^0.34.5",
    "signature_pad": "^5.1.3",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.2",
    "@prisma/client": "^7.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "prisma": "^7.5.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
