# ─────────────────────────────────────────
# App
# ─────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: https://www.sriwanparts.com

# ─────────────────────────────────────────
# Google Analytics 4
# ─────────────────────────────────────────
# GA4 Measurement ID — find in GA4 > Admin > Data Streams > Web Stream
# Leave blank (or omit) in development to disable tracking
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# ─────────────────────────────────────────
# Database (Supabase PostgreSQL)
# ─────────────────────────────────────────
# Connection pooling URL (สำหรับ Prisma ทั่วไป)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL (สำหรับ prisma migrate)
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"
DB_POOL_MAX="5"
DB_IDLE_TIMEOUT_MS="10000"
DB_CONNECTION_TIMEOUT_MS="15000"

# ─────────────────────────────────────────
# NextAuth.js
# ─────────────────────────────────────────
NEXTAUTH_SECRET="your-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"
# Production (Vercel): NEXTAUTH_URL="https://www.sriwanparts.com"

# Storefront cache revalidation webhook — ต้องตั้งแยกจาก NEXTAUTH_SECRET
# Generate: openssl rand -hex 16
REVALIDATE_SECRET="your-revalidate-secret-here"

# Optional seed admin user
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="change-this-to-a-strong-password"
SEED_ADMIN_NAME="ผู้ดูแลระบบ"

# ─────────────────────────────────────────
# Supabase Storage (สำหรับรูปสินค้า)
# ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# Service role key สำหรับ server-side storage upload (bypass RLS) — ห้าม prefix NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ─────────────────────────────────────────
# Vercel Blob Storage (กำลังย้ายรูปจาก Supabase Storage มาที่นี่)
# ─────────────────────────────────────────
# สร้าง Blob store ใน Vercel Dashboard → Storage → Blob แล้วคัดลอก token มาวาง
# (Vercel จะ inject ให้อัตโนมัติบน production ถ้าผูก store กับโปรเจกต์แล้ว)
# Server-only — ห้าม prefix NEXT_PUBLIC_
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# Token ของ Blob store แบบ PRIVATE แยกต่างหาก (เฉพาะ payment slips ที่เป็น PII) — จำเป็นต้องตั้ง.
# สร้าง store อันที่ 2 ใน Vercel แบบ private แล้วเอา token มาวาง.
BLOB_SLIPS_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# LINE OA Daily Summary
# Vercel Cron will send Authorization: Bearer <CRON_SECRET> to the route automatically.
CRON_SECRET="your-cron-secret"
LINE_MESSAGING_API_CHANNEL_ACCESS_TOKEN="your-line-channel-access-token"
LINE_MESSAGING_API_CHANNEL_SECRET="your-line-channel-secret"
# Comma-separated LINE user/group/room ids that should receive the daily summary.
# Used when target mode = ENV_IDS. When target mode = ADMIN_USERS the system will read mapped admin recipients from DB.
LINE_DAILY_SUMMARY_TO_IDS="Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional fallback placeholder image for product Flex cards when a product has no
# image. The shop logo from store settings (shopLogoUrl) is used first; this env is
# only a fallback. Must be a public https JPEG/PNG. If neither is set, image-less
# cards simply omit the image (no broken thumbnail).
LINE_FLEX_PLACEHOLDER_IMAGE_URL="https://www.sriwanparts.com/logo.png"

# Gemini API key selection strategy:
#   sticky (default) = reuse the most-recently-used key first so repeated system
#     instructions hit Gemini implicit prompt caching (~90% off cached tokens).
#   spread = round-robin across keys (set this if one key keeps hitting RPM limits).
GOOGLE_AI_KEY_STRATEGY="sticky"

# LINE LIFF Customer Self-Service
NEXT_PUBLIC_LINE_LIFF_ID="xxxx-xxxxxxxx"
LINE_LIFF_CHANNEL_ID="xxxxxxxxxx"
DOC_VERIFY_SECRET="replace-with-random-32-plus-character-secret"

# ─────────────────────────────────────────
# LINE OA AI Agent — Google Gemini (multi-key fallback)
# ─────────────────────────────────────────
# Up to 10 free Gemini API keys from separate Google accounts (https://aistudio.google.com).
# Server-only — never expose with NEXT_PUBLIC_. The system rotates least-recently-used
# first and, when a key hits its rate/quota limit, automatically falls back to the next.
# You may run with fewer than 10 keys — only the ones present are used.
GOOGLE_AI_API_KEY_1="your-gemini-key-account-1"
GOOGLE_AI_API_KEY_2="your-gemini-key-account-2"
GOOGLE_AI_API_KEY_3="your-gemini-key-account-3"
GOOGLE_AI_API_KEY_4="your-gemini-key-account-4"
GOOGLE_AI_API_KEY_5="your-gemini-key-account-5"
GOOGLE_AI_API_KEY_6="your-gemini-key-account-6"
GOOGLE_AI_API_KEY_7="your-gemini-key-account-7"
GOOGLE_AI_API_KEY_8="your-gemini-key-account-8"
GOOGLE_AI_API_KEY_9="your-gemini-key-account-9"
GOOGLE_AI_API_KEY_10="your-gemini-key-account-10"
# Model id (default: gemini-3.1-flash-lite). Use a multimodal model for image/OCR steps.
GOOGLE_AI_MODEL="gemini-3.1-flash-lite"
# Reasoning depth for Gemini 3: "HIGH" (default) | "LOW" | "NONE".
GOOGLE_AI_THINKING_LEVEL="HIGH"
# Minutes to keep a key on cooldown after a DAILY quota error (default 60).
GOOGLE_AI_DAILY_COOLDOWN_MINUTES="60"
# NOTE: The AI runtime toggles (auto-reply, dry-run, image-search) are NOT env vars.
# They are managed from the admin page: ตั้งค่าร้านค้า → "LINE OA AI Agent"
# (stored in SiteContent: line_ai_auto_reply_enabled / line_ai_dry_run / line_ai_image_search_enabled).

# Delivery route lookup (OSRM-compatible endpoints)
# Put the self-host OSRM endpoint first, then backup endpoints.
OSRM_ENDPOINTS="https://osrm.sriwanparts.com,https://router.project-osrm.org"
OSRM_TIMEOUT_MS="5000"
OSRM_RETRY_PER_ENDPOINT="1"

# Content approval + scheduled Facebook posting
APP_BASE_URL="https://www.sriwanparts.com"
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-5.4-mini"
QSTASH_TOKEN="your-qstash-token"
QSTASH_CURRENT_SIGNING_KEY="your-qstash-current-signing-key"
QSTASH_NEXT_SIGNING_KEY="your-qstash-next-signing-key"
FACEBOOK_PAGE_ID="your-facebook-page-id"
FACEBOOK_PAGE_ACCESS_TOKEN="your-facebook-page-access-token"

# ─────────────────────────────────────────
# Shopee Open Platform (Marketplace integration — isolated module)
# ─────────────────────────────────────────
# Register the app at https://open.shopee.com → get Partner ID + Partner Key.
# Keep test (sandbox) and live credentials separated; never commit real secrets.
# SHOPEE_API_ENV selects the host: "test" = sandbox, "live" = production.
SHOPEE_PARTNER_ID="your-shopee-partner-id"
SHOPEE_PARTNER_KEY="your-shopee-partner-key"
# Must match the callback registered in the Shopee app exactly.
# Production: https://www.sriwanparts.com/api/shopee/callback
SHOPEE_REDIRECT_URL="http://localhost:3000/api/shopee/callback"
SHOPEE_API_ENV="test"
# Optional explicit host override (leave blank to derive from SHOPEE_API_ENV)
# SHOPEE_HOST="https://partner.test-stable.shopeemobile.com"

# ─────────────────────────────────────────
# Telegram owner alerts (Shopee operations)
# ─────────────────────────────────────────
# Create a bot via @BotFather → token. Get chat id(s) the bot should message.
# Leave blank to disable Telegram alerts (system degrades gracefully).
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
# One or more chat ids, comma-separated (group/channel/user)
TELEGRAM_CHAT_IDS="123456789"
