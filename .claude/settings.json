{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run lint -- *)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npm audit)",
      "Bash(npm audit --json)",
      "Bash(npm outdated)",
      "Bash(npm ls *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/protect-paths.mjs"
          }
        ]
      }
    ]
  }
}
